{
  "name": "notion-style-portfolio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "build": "bun run typecheck && vite build && bun run scripts/prerender.ts",
    "preview": "vite preview",
    "deploy": "bun run build && bunx gh-pages -d dist",
    "readmes": "bun run scripts/fetch-readmes.ts",
    "sync": "bun run scripts/sync-data.ts"
  },
  "dependencies": {
    "pixelarticons": "^2.4.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.1",
    "gh-pages": "^6.3.0",
    "marked": "^18.0.14",
    "sanitize-html": "^2.17.7",
    "typescript": "^6.0.3",
    "vite": "^8.3.0"
  }
}
